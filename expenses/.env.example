# Legacy build hint (runtime login default is always Classic/Drupal).
# Both Drupal and Supabase work in one build — ship Supabase keys always.
VITE_DATA_PROVIDER=drupal

# Required for Supabase login / data (include in every dual-provider deploy)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Existing app secrets
VITE_CRYPT_KEY=

# Optional
# VITE_FORCE_LOGS=1
