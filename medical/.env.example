NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Must match an origin allowed under Supabase Authentication → Passkeys (RP Origins).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Passkeys: enable in Dashboard (Authentication → Passkeys). RP ID = bare domain
# (e.g. example.com). RP Origins include NEXT_PUBLIC_SITE_URL and production HTTPS.

# Server only. Never prefix these with NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_TOKEN_ENCRYPTION_KEY=base64-32-byte-key
# Optional. Force the family Drive root to this "Dosar medical" folder id.
GOOGLE_DRIVE_ROOT_FOLDER_ID=1q-yQh0PN3kyRZMXVxF6SuTnjwn8u6uVc
GEMINI_API_KEY=your-gemini-api-key

# Web Push (appointment reminders). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com
# Cron auth for /api/cron/appointment-reminders (Vercel sends Authorization: Bearer …)
CRON_SECRET=long-random-secret
# Server-only. Needed by the daily push cron (bypasses RLS). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
